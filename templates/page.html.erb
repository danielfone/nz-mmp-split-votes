<%- light, dark = palette_css -%>
<!doctype html>
<html lang="en-NZ">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= h title %> · New Zealand MMP Split-Vote Explorer</title>
<link rel="canonical" href="<%= page_path(year, slug) %>">
<style>
  :root {
    --ink: #1b1f24; --muted: #5c6670; --line: #d8dde2; --bg: #ffffff; --panel: #f2f4f6; --link: #1f5fa8; --heat: var(--ink);
    <%= light %>
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root { --ink: #e6e9ec; --muted: #9aa4ad; --line: #343a40; --bg: #15181b; --panel: #22272c; --link: #7fb2ec; <%= dark %> }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
  a { color: var(--link); }
  main, header, footer { max-width: 760px; margin: 0 auto; padding: 0 16px; }
  header { padding-top: 24px; text-align: center; }
  .site { display: inline-block; color: var(--ink); text-decoration: none; line-height: 1.1; }
  .site span { display: block; }
  .site .kicker { font-size: .8125rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .site .name { font-size: 2.25rem; font-weight: 700; letter-spacing: -.01em; }
  .switch { font: inherit; color: inherit; background: none; border: 0; border-radius: 6px; padding: 0 4px; margin: 0 -4px; cursor: pointer; text-decoration: underline dotted var(--muted); text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .switch:hover { background: var(--panel); }
  .switch:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
  .chev { font-size: .55em; color: var(--muted); margin-left: .25em; vertical-align: .25em; }
  .menu { margin: auto; width: min(44rem, calc(100vw - 32px)); max-height: 80vh; overflow: auto; padding: 16px; color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 8px; }
  .menu::backdrop { background: rgb(0 0 0 / .35); }
  .menu h2 { margin: 0 0 8px; }
  .menu a[aria-current] { font-weight: 700; color: var(--ink); text-decoration: none; }
  .year-nav { display: flex; justify-content: center; align-items: center; gap: 8px; margin: 20px 0 0; font-size: 1.25rem; font-weight: 600; }
  .year-nav a, .year-nav .off { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 22px; font-size: 1.6rem; line-height: 1; text-decoration: none; }
  .year-nav a:hover { background: var(--panel); }
  .year-nav .off { color: var(--line); cursor: default; }
  .place { display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: 4px 16px; margin: 4px 0 16px; }
  .place .nationwide { font-size: 1.05rem; }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .electorates { columns: 3 11em; gap: 16px; padding: 0; margin: 4px 0 12px; list-style: none; font-size: .9375rem; }
  .electorates li { break-inside: avoid; }
  h1 { font-size: 1.6rem; line-height: 1.2; margin: 0; }
  h2 { font-size: 1.2rem; margin: 32px 0 8px; }
  h3 { font-size: 1rem; margin: 12px 0 4px; }
  .status { color: var(--muted); margin: 0 0 16px; }
  .lede { font-size: 1.1rem; margin: 0 0 8px; }
  .splits { margin: 0 0 16px; padding-left: 1.5em; }
  .splits li { margin: 0 0 2px; }
  figure { margin: 0; }
  .sankey { display: block; width: 100%; height: auto; background: var(--bg); overflow: visible; }
  .sankey-n { display: none; }
  @media (max-width: 560px) { .sankey-w { display: none; } .sankey-n { display: block; } }
  .sankey .f { opacity: .6; transition: opacity .15s; }
  .sankey .f.same { opacity: .16; }
  .sankey text { font-size: 13px; fill: var(--ink); paint-order: stroke; stroke: var(--bg); stroke-width: 4px; stroke-linejoin: round; }
  .sankey .name { font-weight: 600; }
  .sankey .upper { font-weight: 400; letter-spacing: .05em; }
  .sankey .node[tabindex] { cursor: pointer; outline: none; }
  .sankey .node:focus .bar { stroke: var(--ink); stroke-width: 2; }
  .sankey .node:focus-visible text { text-decoration: underline; }
  .note { margin: 8px 0 0; padding: 8px 12px; background: var(--panel); border-left: 4px solid var(--muted); }
  figcaption { margin: 8px 0 0; color: var(--muted); font-size: .9375rem; }
  /* Selecting (focusing) a node fades every ribbon, then lifts that node's ribbons and shows its description in place of the caption. */
  .desc { display: none; margin: 8px 0 0; font-size: .9375rem; }
  .desc p { margin: 0 0 4px; font-weight: 600; }
  .desc ul { margin: 0; padding-left: 1.5em; columns: 2 18em; column-gap: 24px; }
  .desc .rest { color: var(--muted); }
  .chart:has(.node:focus) .f { opacity: .05; }
  .chart:has(.node:focus) figcaption { display: none; }
<%- nodes.select(&:desc).each do |n| -%>
  .chart:has(#w-<%= n.id %>:focus, #n-<%= n.id %>:focus) .f.<%= n.id %> { opacity: .8; }
  .chart:has(#w-<%= n.id %>:focus, #n-<%= n.id %>:focus) #d-<%= n.id %> { display: block; }
<%- end -%>
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 4px; margin: 0 0 16px; }
  /* The split-vote table can be wider than the text column. */
  .table-wrap.wide { width: min(1100px, calc(100vw - 40px)); margin-left: calc(50% - min(550px, 50vw - 20px)); }
  /* Heat map: split cells are tinted by share (up to 50% strength, so text keeps its contrast). */
  td.split { background: color-mix(in srgb, var(--heat) var(--h), var(--bg)); }
  td.strong { font-weight: 600; }
  .table-note { color: var(--muted); font-size: .9375rem; margin: 0 0 8px; }
  td.same { color: var(--muted); box-shadow: inset 0 0 0 1px var(--line); }
  thead .line { display: block; white-space: nowrap; font-weight: 400; }
  thead .surname { font-weight: 600; }
  thead .party { color: var(--muted); }
  @media (min-width: 700px) { th[scope=row] { min-width: 13em; } }
  .table-wrap:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
  table { border-collapse: collapse; font-size: .875rem; font-variant-numeric: tabular-nums; width: 100%; }
  caption { text-align: left; padding: 8px; font-weight: 600; }
  th, td { padding: 6px 12px; border-top: 1px solid var(--line); text-align: right; vertical-align: top; }
  th[scope=row], thead th:first-child, td.text { text-align: left; }
  thead th { vertical-align: bottom; font-weight: 600; }
  th[scope=row], thead th:first-child { position: sticky; left: 0; z-index: 1; background: var(--bg); }
  footer { margin-top: 40px; padding-bottom: 32px; color: var(--muted); font-size: .875rem; border-top: 1px solid var(--line); }
  footer a { color: inherit; }
  @media (forced-colors: active) { .sankey { forced-color-adjust: none; } }
  @media (prefers-reduced-motion: reduce) { .sankey .f { transition: none; } }
</style>
</head>
<body>
<%- lists = electorate_lists(year) -%>
<header>
  <a class="site" href="/"><span class="kicker">New Zealand MMP</span> <span class="name">Split-Vote Explorer</span></a>
  <div id="place-menu" class="menu" popover>
    <h2><%= year %> electorates</h2>
    <p><a href="<%= page_path(year, 'national') %>"<%= ' aria-current="page"' if national? %>>Nationwide</a></p>
    <%- [["general", "General electorates"], ["maori", "Māori electorates"]].each do |type, heading| -%>
    <h3><%= heading %></h3>
    <ul class="electorates">
    <%- lists[type].to_a.each do |r| -%>
      <li><a href="<%= page_path(year, r.slug) %>"<%= ' aria-current="page"' if r.slug == slug %>><%= h r.name %></a></li>
    <%- end -%>
    </ul>
    <%- end -%>
  </div>
</header>
<main>
<%# Previous/next election for the same place, greyed where the place didn't exist that year. %>
<nav class="year-nav" aria-label="Election year">
<%- prev_year, next_year = neighbours(self) -%>
<%- [[prev_year, "‹", "prev"], [:current], [next_year, "›", "next"]].each do |y, arrow, rel| -%>
<%- if y == :current -%>
  <span aria-current="page"><%= year %></span>
<%- elsif y.nil? -%>
  <span class="off" aria-hidden="true"></span>
<%- elsif y[1] -%>
  <a href="<%= y[1] %>" rel="<%= rel %>" aria-label="<%= y[0] %> election"><%= arrow %></a>
<%- else -%>
  <span class="off" title="No <%= h name %> electorate in <%= y[0] %>"><span aria-hidden="true"><%= arrow %></span><span class="vh">No <%= h name %> electorate in <%= y[0] %></span></span>
<%- end -%>
<%- end -%>
</nav>
<%# The electorate name opens the electorate menu. The chevron is hidden so the heading reads "Selwyn 2023". %>
<div class="place">
<h1><button class="switch" popovertarget="place-menu" aria-describedby="place-hint"><%= h name %><span class="chev" aria-hidden="true">▾</span></button><span class="vh"> <%= year %></span></h1>
<%- unless national? -%>
<a class="nationwide" href="<%= page_path(year, 'national') %>">Nationwide</a>
<%- end -%>
</div>
<span id="place-hint" hidden>Change electorate</span>
<%- if flows? -%>
<p class="status"><%= status.capitalize %> results · split votes published</p>
<p class="lede" id="summary">About <%= split_share %> of <%= h where %> gave their electorate vote to a candidate from a different party.</p>
<%- if top_splits.any? -%>
<ul class="splits">
<%- top_splits.each do |share, party, cand| -%>
  <li><strong><%= share.round %>%</strong> of <%= h party.label %> party voters chose <%= h split_target(cand) %></li>
<%- end -%>
</ul>
<%- end -%>
<%- elsif candidates.any? -%>
<p class="status"><%= status.capitalize %> count · split votes not yet published</p>
<p class="lede" id="summary">Party votes and electorate candidate votes<%= national? ? ' nationwide' : " in #{h name}" %>. How each party's voters cast their candidate vote will be shown once the Electoral Commission publishes split-vote statistics.</p>
<%- else -%>
<p class="status" id="summary"><%= status.capitalize %> results · party votes only</p>
<%- end -%>

<figure class="chart">
<%= chart %>
<%- if flows? -%>
<%- descriptions.each do |id, heading, rows, rest| -%>
  <div class="desc" id="d-<%= id %>">
    <p><%= h heading %></p>
    <ul>
    <%- rows.each do |share, text| -%>
      <li><strong><%= share %>%</strong> <%= h text %></li>
    <%- end -%>
    <%- if rest -%>
      <li class="rest">Others under 1% each</li>
    <%- end -%>
    </ul>
  </div>
<%- end -%>
  <figcaption>Party votes are on the left, electorate votes on the right. Each ribbon is the voters who chose that party and that candidate, drawn to scale. Coloured ribbons are split votes; faint ribbons stayed with the same party or cast no valid electorate vote. Parties under 2% and informal votes are grouped as “Other”<%= national? ? ', as are candidates under 2% and independents' : '' %>. Select a party or candidate to highlight its votes.</figcaption>
<%- elsif candidates.any? -%>
  <p class="note">Bars show each column's own total: <%= num party_total %> party votes and <%= num candidate_total %> candidate votes. The totals differ because party and candidate votes are counted, and ruled informal, separately.</p>
<%- end -%>
<%- if note -%>
  <p class="note"><%= h note %></p>
<%- end -%>
</figure>


<%- if flows? -%>
<h2>All figures</h2>
<p class="table-note">Shaded cells are split votes: the darker the cell, the larger the share of that party's voters who chose another party's candidate. Outlined cells are votes for the party's own candidate.</p>
<div class="table-wrap wide" tabindex="0" role="region" aria-labelledby="table-caption">
<table>
  <caption id="table-caption">Electorate vote by party vote, <%= h title %>. Percentages are of each party's voters.</caption>
  <thead>
    <tr>
      <th scope="col">Party vote</th>
      <th scope="col">Voters</th>
    <%- table_candidates.each do |c| -%>
      <%- if c.person? -%>
      <%- surname, given = c.name.split(", ", 2) -%>
      <th scope="col"><span class="line surname"><%= h surname %></span> <span class="line"><%= h given %></span> <span class="line party"><%= h(c.party.to_s.empty? ? "Independent" : c.party) %></span></th>
      <%- else -%>
      <th scope="col"><%= h c.official %></th>
      <%- end -%>
    <%- end -%>
    </tr>
  </thead>
  <tbody>
  <%- parties.each do |p| -%>
    <tr>
      <th scope="row"><%= h p.label %></th>
      <td><%= num p.votes %></td>
    <%- table_candidates.each do |c| cell = p.cells[c.name]; heat = heat(p, c) -%>
      <%- if heat == :same -%>
      <td class="same"><%= cell.pct %>%</td>
      <%- elsif heat -%>
      <td class="split<%= ' strong' if heat >= SPLIT_SHARE %>" style="--h:<%= (heat / 2).round(1) %>%"><%= cell.pct %>%</td>
      <%- else -%>
      <td><%= cell.pct %>%</td>
      <%- end -%>
    <%- end -%>
    </tr>
  <%- end -%>
  </tbody>
</table>
</div>
<%- else -%>
<h2>All figures</h2>
<div class="table-wrap" tabindex="0" role="region" aria-labelledby="party-caption">
<table>
  <caption id="party-caption">Party votes, <%= h title %> (<%= status %>)</caption>
  <thead><tr><th scope="col">Party</th><th scope="col">Votes</th><th scope="col">Share</th></tr></thead>
  <tbody>
  <%- parties.each do |p| -%>
    <tr><th scope="row"><%= h p.informal? ? p.label : p.name %></th><td><%= num p.votes %></td><td><%= pct(p.votes, party_total) %></td></tr>
  <%- end -%>
  </tbody>
</table>
</div>
<%- if candidates.any? -%>
<div class="table-wrap" tabindex="0" role="region" aria-labelledby="candidate-caption">
<table>
  <caption id="candidate-caption">Candidate votes<%= ' by party' if national? %>, <%= h title %> (<%= status %>)</caption>
  <thead><tr><th scope="col">Candidate</th><%- unless national? -%><th scope="col">Party</th><%- end -%><th scope="col">Votes</th><th scope="col">Share</th></tr></thead>
  <tbody>
  <%- candidates.each do |c| -%>
    <tr><th scope="row"><%= h(c.person? ? c.name : c.official) %></th><%- unless national? -%><td class="text"><%= c.person? ? h(c.party.to_s.empty? ? 'Independent' : c.party) : '' %></td><%- end -%><td><%= num c.votes %></td><td><%= pct(c.votes, candidate_total) %></td></tr>
  <%- end -%>
  </tbody>
</table>
</div>
<%- end -%>
<%- end -%>
<%- if national? -%>
<h2><%= year %> electorates</h2>
<%- [["general", "General electorates"], ["maori", "Māori electorates"]].each do |type, heading| -%>
<h3><%= heading %></h3>
<ul class="electorates">
<%- lists[type].to_a.each do |r| -%>
  <li><a href="<%= page_path(year, r.slug) %>"><%= h r.name %></a></li>
<%- end -%>
</ul>
<%- end -%>
<%- end -%>
</main>
<footer>
  <p>Data © Electoral Commission New Zealand, from <a href="<%= source %>">electionresults.govt.nz</a>.</p>
  <%- if flows? -%>
  <p>Split votes are published as percentages of each party's voters, to two decimal places, and the table shows them as published. Other figures, such as ribbon widths and the headline share, are calculated from those percentages and each party's total, so may be off by a few votes.</p>
  <%- elsif status == 'preliminary' -%>
  <p>Preliminary count: figures will change when the official result is declared.</p>
  <%- end -%>
  <p>Code MIT licensed.</p>
</footer>
</body>
</html>
